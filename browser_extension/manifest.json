{
  "manifest_version": 3,
  "name": "Auto Timesheet Companion",
  "version": "1.0.0",
  "description": "Companion extension for Auto Timesheet Desktop App. Captures web visits, form submissions, and webmail sent events.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:58432/*",
    "http://localhost:58432/*",
    "https://mail.google.com/*",
    "https://outlook.live.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto Timesheet Tracker"
  }
}
